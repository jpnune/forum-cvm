# Copie para .env.local e preencha. Nunca commite o .env.local.

# Neon > seu projeto > Connect > connection string (com ?sslmode=require)
DATABASE_URL=

# Better Auth: gere um segredo com `npx @better-auth/cli secret` (ou qualquer texto aleatório de 32+ caracteres)
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 | Vercel: a URL pública do site
BETTER_AUTH_URL=http://localhost:3000

# Brevo (e-mails): app.brevo.com > SMTP & API > API Keys. Sem chave, os e-mails são pulados.
BREVO_API_KEY=
# Remetente verificado no Brevo (Senders, Domains & Dedicated IPs)
EMAIL_FROM=
EMAIL_FROM_NAME=Fórum do Condomínio
# Vercel: segredo do cron (/api/cron); qualquer texto aleatório de 16+ caracteres
CRON_SECRET=
